# Git Ignore Rules for Parkinson's Disease ML Project

# PDF documents and binary research papers
*.pdf

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Virtual Environments
venv/
.venv/
env/
ENV/

# OS / Editor temporary files
.DS_Store
.vscode/
.idea/
~$*

# Large model artifacts and temporary logs (optional)
*.log
